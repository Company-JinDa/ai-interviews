{
  "compilerOptions": {
    "target": "ES2020",                      // nâng từ ES2017 lên ES2020 (từ Node config)
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,                          // từ Next config
    "esModuleInterop": true,
    "module": "esnext",                      // giữ của Next (Node thì CommonJS)
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "outDir": "dist",                        
    "forceConsistentCasingInFileNames": true 
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "next.config.js",
    ".next/types/**/*.ts"
, "docker-test/server.js", "docker-test/server.js"  ],
  "exclude": [
    ".next",
    "node_modules",
    "dist"                                   // thêm để tránh build ra rồi lại include
  ]
}
